# Block abusive crawlers by User-Agent.
# Bytespider (ByteDance) triggered DoS-like traffic on 2026-04-14 (≈46% of requests
# in a 6h window), exhausting the API's ES connection pool.
map $http_user_agent $ddbj_search_blocked_ua {
  default 0;
  "~*Bytespider" 1;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;

  if ($ddbj_search_blocked_ua) {
    return 403;
  }

  # --- Common settings ---
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  # Forward caller-supplied X-Request-ID so the API middleware can echo it back;
  # if absent, $http_x_request_id is empty and the API generates its own UUID.
  proxy_set_header X-Request-ID $http_x_request_id;
  proxy_set_header Connection "";

  # Bulk POST body size (up to 1000 IDs)
  client_max_body_size 1m;

  # Backend addresses are resolved per request rather than once at startup.
  # A backend that restarts comes back on a different IP, and an address
  # resolved at startup stays pinned to the dead one until nginx itself is
  # restarted, which turns every proxied request into a 502. Routing the
  # address through a variable is what forces the re-resolution: a literal
  # name is resolved once and cached for the life of the process. It also
  # removes the start-order requirement, because nothing is looked up while
  # the configuration is being parsed.
  #
  # The resolver address itself is written into conf.d at container start from
  # the container's own /etc/resolv.conf. Pinning it per environment instead
  # breaks as soon as the container network is recreated on a different subnet,
  # and a wrong resolver takes down every backend lookup at once.
  set $api_backend "http://ddbj-search-api-${DDBJ_SEARCH_ENV}:8080";
  set $front_backend "http://ddbj-search-front-${DDBJ_SEARCH_ENV}:3000";

  # === favicon ===
  # We intentionally ship no favicon. Browsers still auto-fetch /favicon.ico,
  # so swallow it with 204 No Content to keep the console clean.
  location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
  }

  # === Special case: entry detail as JSON/JSONLD ===
  # Frontend URL with .json/.jsonld extension -> rewrite to API entry path.
  # The backend FastAPI router is mounted at the root (e.g. /entries/{type}/{id}.json),
  # not under /search/api, so the rewrite target uses the unprefixed router path.
  # e.g. /search/entry/bioproject/PRJNA16.json -> /entries/bioproject/PRJNA16.json
  location ~ ^/search/entry/([^/]+)/([^/]+)\.(json|jsonld)$ {
    rewrite ^/search/entry/(.+)\.(json|jsonld)$ /entries/$1.$2 break;
    proxy_pass $api_backend;
  }

  # === API Server ===
  # The backend FastAPI router is mounted at the root; the public /search/api
  # prefix lives only in the OpenAPI `servers` block. nginx therefore strips the
  # prefix before forwarding so that /search/api/entries/... reaches the router
  # as /entries/... and matches.
  # Split exact + trailing-slash prefix so that sibling paths like /search/api-doc/
  # (a frontend SPA route) are not captured by a bare /search/api prefix match.
  # With a literal address, the trailing slash on proxy_pass is what strips the
  # prefix. That form has no equivalent once the address comes from a variable,
  # so the strip is spelled out as a rewrite instead.
  location = /search/api {
    rewrite ^/search/api$ / break;
    proxy_pass $api_backend;
  }
  location /search/api/ {
    rewrite ^/search/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
  }

  # === Backward compatibility redirects ===

  # prev: https://ddbj.nig.ac.jp/resource/bioproject/PRJDB12105
  # new: https://ddbj.nig.ac.jp/search/entry/bioproject/PRJDB12105
  location /resource {
    rewrite ^/resource(.*)$ https://$host/search/entry$1 permanent;
  }

  # prev: https://ddbj.nig.ac.jp/entry/bioproject/PRJDB12105
  # new: https://ddbj.nig.ac.jp/search/entry/bioproject/PRJDB12105
  location /entry {
    rewrite ^/entry(.*)$ https://$host/search/entry$1 permanent;
  }

  # === Frontend (catch-all) ===
  location /search {
    proxy_pass $front_backend;
  }
}
