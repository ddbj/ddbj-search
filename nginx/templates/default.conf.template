# Block abusive crawlers by User-Agent.
# Bytespider (ByteDance) triggered DoS-like traffic on 2026-04-14 (≈46% of requests
# in a 6h window), exhausting the API's ES connection pool.
map $http_user_agent $ddbj_search_blocked_ua {
  default 0;
  "~*Bytespider" 1;
}

# --- Client address ---
# Every connection arrives from inside the container network; the real client
# is only in the X-Forwarded-For set by the external proxy. Only private
# addresses are trusted, and with real_ip_recursive the right-most untrusted
# address wins, so a client-supplied X-Forwarded-For cannot choose the result.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# X-Forwarded-For for the backends: what we received plus the peer we actually
# accepted the connection from. $proxy_add_x_forwarded_for appends $remote_addr,
# which after realip is the restored client address and would be listed twice.
map $http_x_forwarded_for $ddbj_search_forwarded_for {
  ""      $realip_remote_addr;
  default "$http_x_forwarded_for, $realip_remote_addr";
}

# --- Crawler throttling ---
# Buckets are shared per kind of client, never per IP. Abusive crawlers spread
# over tens of thousands of proxy addresses with one or two requests each, so a
# per-IP limit never sees them, while a single institution pulling a lot of
# data from one address is ordinary use and must not be slowed down.
# An empty key means the request is not counted at all.

# Self-declared crawlers: one bucket per crawler name.
map $http_user_agent $ddbj_search_crawler_name {
  default "";
  "~*(?<name>[a-z0-9_.-]*(?:bot|crawler|spider)[a-z0-9_.-]*)" $name;
}

# Clients claiming a Chrome older than 135, all in one bucket. User-Agent
# rotating botnets cycle through a pool of old versions, while real Chrome
# updates itself. Self-declared crawlers are left out: search engine crawlers
# carry an old Chrome/ token too and would otherwise be starved by the botnet.
# Keep the threshold about a year and a half behind the current Chrome.
map "$ddbj_search_crawler_name|$http_user_agent" $ddbj_search_stale_chrome {
  default "";
  "~^\|.*Chrome/(?:\d{1,2}|1[0-2]\d|13[0-4])\." "stale-chrome";
}

limit_req_zone $ddbj_search_crawler_name zone=ddbj_search_crawler:1m rate=10r/s;
limit_req_zone $ddbj_search_stale_chrome zone=ddbj_search_stale_chrome:1m rate=5r/s;

log_format ddbj_search '$remote_addr - $remote_user [$time_local] "$request" '
                       '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                       'rt=$request_time urt=$upstream_response_time '
                       'bot=$ddbj_search_crawler_name$ddbj_search_stale_chrome limit=$limit_req_status';

# Only requests worth investigating are logged: server errors, client
# disconnects, and anything that took a second or more. The external proxy
# already keeps a line for every request, so a full log here would only repeat
# it, and at crawler-flood rates it rotates away within hours.
# $request_time is "<seconds>.<millis>", so a leading non-zero digit means >= 1s.
map "$status:$request_time" $ddbj_search_loggable {
  default 0;
  "~^5"      1;
  "~^499:"   1;
  "~:[1-9]"  1;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;

  if ($ddbj_search_blocked_ua) {
    return 403;
  }

  access_log /var/log/nginx/access.log ddbj_search if=$ddbj_search_loggable;

  # Reject over-limit requests right away instead of queueing them: requests
  # left waiting on a backend end up as client disconnects (499) that drag
  # ordinary traffic down with them.
  limit_req zone=ddbj_search_crawler burst=50 nodelay;
  limit_req zone=ddbj_search_stale_chrome burst=25 nodelay;
  limit_req_status 429;
  # Rejections are not logged one by one: under attack they would be most of
  # the log. info is below the error_log level, so these lines are dropped.
  limit_req_log_level info;
  error_page 429 = @rate_limited;

  # --- Common settings ---
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $ddbj_search_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  # Forward caller-supplied X-Request-ID so the API middleware can echo it back;
  # if absent, $http_x_request_id is empty and the API generates its own UUID.
  proxy_set_header X-Request-ID $http_x_request_id;
  proxy_set_header Connection "";

  # Bulk POST body size (up to 1000 IDs)
  client_max_body_size 1m;

  # Backend addresses are resolved per request rather than once at startup.
  # A backend that restarts comes back on a different IP, and an address
  # resolved at startup stays pinned to the dead one until nginx itself is
  # restarted, which turns every proxied request into a 502. Routing the
  # address through a variable is what forces the re-resolution: a literal
  # name is resolved once and cached for the life of the process. It also
  # removes the start-order requirement, because nothing is looked up while
  # the configuration is being parsed.
  #
  # The resolver address itself is written into conf.d at container start from
  # the container's own /etc/resolv.conf. Pinning it per environment instead
  # breaks as soon as the container network is recreated on a different subnet,
  # and a wrong resolver takes down every backend lookup at once.
  set $api_backend "http://ddbj-search-api-${DDBJ_SEARCH_ENV}:8080";
  set $front_backend "http://ddbj-search-front-${DDBJ_SEARCH_ENV}:3000";

  location @rate_limited {
    add_header Retry-After 60 always;
    return 429;
  }

  # === favicon ===
  # We intentionally ship no favicon. Browsers still auto-fetch /favicon.ico,
  # so swallow it with 204 No Content to keep the console clean.
  location = /favicon.ico {
    access_log off;
    log_not_found off;
    return 204;
  }

  # === Special case: entry detail as JSON/JSONLD ===
  # Frontend URL with .json/.jsonld extension -> rewrite to API entry path.
  # The backend FastAPI router is mounted at the root (e.g. /entries/{type}/{id}.json),
  # not under /search/api, so the rewrite target uses the unprefixed router path.
  # e.g. /search/entry/bioproject/PRJNA16.json -> /entries/bioproject/PRJNA16.json
  location ~ ^/search/entry/([^/]+)/([^/]+)\.(json|jsonld)$ {
    rewrite ^/search/entry/(.+)\.(json|jsonld)$ /entries/$1.$2 break;
    proxy_pass $api_backend;
  }

  # === API Server ===
  # The backend FastAPI router is mounted at the root; the public /search/api
  # prefix lives only in the OpenAPI `servers` block. nginx therefore strips the
  # prefix before forwarding so that /search/api/entries/... reaches the router
  # as /entries/... and matches.
  # Split exact + trailing-slash prefix so that sibling paths like /search/api-doc/
  # (a frontend SPA route) are not captured by a bare /search/api prefix match.
  # With a literal address, the trailing slash on proxy_pass is what strips the
  # prefix. That form has no equivalent once the address comes from a variable,
  # so the strip is spelled out as a rewrite instead.
  location = /search/api {
    rewrite ^/search/api$ / break;
    proxy_pass $api_backend;
  }
  location /search/api/ {
    rewrite ^/search/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
  }

  # === Backward compatibility redirects ===

  # prev: https://ddbj.nig.ac.jp/resource/bioproject/PRJDB12105
  # new: https://ddbj.nig.ac.jp/search/entry/bioproject/PRJDB12105
  location /resource {
    rewrite ^/resource(.*)$ https://$host/search/entry$1 permanent;
  }

  # prev: https://ddbj.nig.ac.jp/entry/bioproject/PRJDB12105
  # new: https://ddbj.nig.ac.jp/search/entry/bioproject/PRJDB12105
  location /entry {
    rewrite ^/entry(.*)$ https://$host/search/entry$1 permanent;
  }

  # === Frontend (catch-all) ===
  location /search {
    proxy_pass $front_backend;
  }
}
